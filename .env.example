# Neura ERP — Tecnolabo
# Plantilla de variables. SIN VALORES REALES.
# Copiar a .env.local y completar desde el gestor de secretos autorizado.
# .env* está en .gitignore: nunca commitear valores reales.

# ── Supabase ──────────────────────────────────────────────────────────────────
# URL pública de la API (browser + servidor).
NEXT_PUBLIC_SUPABASE_URL=https://api.neura.com.py
# Anon key pública. Necesaria en buildtime (se incrusta en el bundle).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role: SOLO backend/runtime. Nunca exponer al navegador.
SUPABASE_SERVICE_ROLE_KEY=
# Conexión directa a PostgreSQL: solo scripts y API routes autorizadas.
SUPABASE_DB_URL=

# ── Instancia monocliente ─────────────────────────────────────────────────────
# Schema operativo. NEXT_PUBLIC_APP_DB_SCHEMA es la única que llega al navegador:
# sin ella el cliente browser no conoce el schema. Las tres deben coincidir.
APP_DB_SCHEMA=tecnolabo
NEXT_PUBLIC_APP_DB_SCHEMA=tecnolabo
NEURA_CLIENT_SCHEMA=tecnolabo
NEURA_INSTANCE_MODE=single_client
# Nombre visible y en logs. La variante NEXT_PUBLIC_ se usa en componentes cliente.
NEURA_CLIENT_NAME=Tecnolabo
NEXT_PUBLIC_NEURA_CLIENT_NAME=Tecnolabo

# ── Build ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
NIXPACKS_NODE_VERSION=22

# ── Correo saliente (opcional) ────────────────────────────────────────────────
# Completar solo si Tecnolabo va a enviar correo desde el ERP.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Destinatario de notificaciones de órdenes de compra.
OC_EMAIL_TO=

# ── Feature flags ─────────────────────────────────────────────────────────────
# Devoluciones de ventas vienen habilitadas por defecto; poner false para apagar.
DEVOLUCIONES_VENTAS_ENABLED=
